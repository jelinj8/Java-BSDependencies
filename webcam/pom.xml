<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>cz.bliksoft.java</groupId>
		<artifactId>dependency-management</artifactId>
		<version>${revision}</version>
	</parent>

	<artifactId>dependency-management-webcam</artifactId>
	<name>Dependency Management Webcam</name>
	<description>Webcam capture (sarxos webcam-capture) and OpenCV (bytedeco, with OpenBLAS and
		JavaCPP). The natives of the build machine come from the OS-activated profiles below;
		-Djavacpp.platform=&lt;platform&gt; (a system property - profile activation does not see
		the properties of the consuming POM) selects another platform instead. Natives of the
		other platforms for per-platform packaging: copy the classifier variants of the
		org.bytedeco dependencies (maven-dependency-plugin copy-dependencies with classifier).</description>
	<packaging>pom</packaging>

	<dependencies>
		<!-- https://mvnrepository.com/artifact/com.github.sarxos/webcam-capture -->
		<dependency>
			<groupId>com.github.sarxos</groupId>
			<artifactId>webcam-capture</artifactId>
		</dependency>
		<!-- https://github.com/bytedeco/javacpp-presets/tree/master/opencv - Java API jars;
		     OpenCV core needs OpenBLAS -->
		<dependency>
			<groupId>org.bytedeco</groupId>
			<artifactId>opencv</artifactId>
		</dependency>
		<dependency>
			<groupId>org.bytedeco</groupId>
			<artifactId>openblas</artifactId>
		</dependency>
		<dependency>
			<groupId>org.bytedeco</groupId>
			<artifactId>javacpp</artifactId>
		</dependency>
	</dependencies>

	<profiles>
		<!-- natives of the build machine (when -Djavacpp.platform is not given) -->
		<profile>
			<id>webcam-host-windows-x86_64</id>
			<activation>
				<property>
					<name>!javacpp.platform</name>
				</property>
				<os>
					<family>windows</family>
					<arch>amd64</arch>
				</os>
			</activation>
			<dependencies>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>opencv</artifactId>
					<classifier>windows-x86_64</classifier>
				</dependency>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>openblas</artifactId>
					<classifier>windows-x86_64</classifier>
				</dependency>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>javacpp</artifactId>
					<classifier>windows-x86_64</classifier>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>webcam-host-linux-x86_64</id>
			<activation>
				<property>
					<name>!javacpp.platform</name>
				</property>
				<os>
					<name>Linux</name>
					<arch>amd64</arch>
				</os>
			</activation>
			<dependencies>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>opencv</artifactId>
					<classifier>linux-x86_64</classifier>
				</dependency>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>openblas</artifactId>
					<classifier>linux-x86_64</classifier>
				</dependency>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>javacpp</artifactId>
					<classifier>linux-x86_64</classifier>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>webcam-host-linux-arm64</id>
			<activation>
				<property>
					<name>!javacpp.platform</name>
				</property>
				<os>
					<name>Linux</name>
					<arch>aarch64</arch>
				</os>
			</activation>
			<dependencies>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>opencv</artifactId>
					<classifier>linux-arm64</classifier>
				</dependency>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>openblas</artifactId>
					<classifier>linux-arm64</classifier>
				</dependency>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>javacpp</artifactId>
					<classifier>linux-arm64</classifier>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>webcam-host-macosx-x86_64</id>
			<activation>
				<property>
					<name>!javacpp.platform</name>
				</property>
				<os>
					<family>mac</family>
					<arch>x86_64</arch>
				</os>
			</activation>
			<dependencies>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>opencv</artifactId>
					<classifier>macosx-x86_64</classifier>
				</dependency>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>openblas</artifactId>
					<classifier>macosx-x86_64</classifier>
				</dependency>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>javacpp</artifactId>
					<classifier>macosx-x86_64</classifier>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>webcam-host-macosx-arm64</id>
			<activation>
				<property>
					<name>!javacpp.platform</name>
				</property>
				<os>
					<family>mac</family>
					<arch>aarch64</arch>
				</os>
			</activation>
			<dependencies>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>opencv</artifactId>
					<classifier>macosx-arm64</classifier>
				</dependency>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>openblas</artifactId>
					<classifier>macosx-arm64</classifier>
				</dependency>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>javacpp</artifactId>
					<classifier>macosx-arm64</classifier>
				</dependency>
			</dependencies>
		</profile>
		<!-- natives of an explicitly selected platform: -Djavacpp.platform=<platform> -->
		<profile>
			<id>webcam-platform-windows-x86_64</id>
			<activation>
				<property>
					<name>javacpp.platform</name>
					<value>windows-x86_64</value>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>opencv</artifactId>
					<classifier>windows-x86_64</classifier>
				</dependency>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>openblas</artifactId>
					<classifier>windows-x86_64</classifier>
				</dependency>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>javacpp</artifactId>
					<classifier>windows-x86_64</classifier>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>webcam-platform-linux-x86_64</id>
			<activation>
				<property>
					<name>javacpp.platform</name>
					<value>linux-x86_64</value>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>opencv</artifactId>
					<classifier>linux-x86_64</classifier>
				</dependency>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>openblas</artifactId>
					<classifier>linux-x86_64</classifier>
				</dependency>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>javacpp</artifactId>
					<classifier>linux-x86_64</classifier>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>webcam-platform-linux-arm64</id>
			<activation>
				<property>
					<name>javacpp.platform</name>
					<value>linux-arm64</value>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>opencv</artifactId>
					<classifier>linux-arm64</classifier>
				</dependency>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>openblas</artifactId>
					<classifier>linux-arm64</classifier>
				</dependency>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>javacpp</artifactId>
					<classifier>linux-arm64</classifier>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>webcam-platform-macosx-x86_64</id>
			<activation>
				<property>
					<name>javacpp.platform</name>
					<value>macosx-x86_64</value>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>opencv</artifactId>
					<classifier>macosx-x86_64</classifier>
				</dependency>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>openblas</artifactId>
					<classifier>macosx-x86_64</classifier>
				</dependency>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>javacpp</artifactId>
					<classifier>macosx-x86_64</classifier>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>webcam-platform-macosx-arm64</id>
			<activation>
				<property>
					<name>javacpp.platform</name>
					<value>macosx-arm64</value>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>opencv</artifactId>
					<classifier>macosx-arm64</classifier>
				</dependency>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>openblas</artifactId>
					<classifier>macosx-arm64</classifier>
				</dependency>
				<dependency>
					<groupId>org.bytedeco</groupId>
					<artifactId>javacpp</artifactId>
					<classifier>macosx-arm64</classifier>
				</dependency>
			</dependencies>
		</profile>
	</profiles>
</project>
